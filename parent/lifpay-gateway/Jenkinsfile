pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['DEPLOY','ROLLBACK'],description: '选择操作： DEPLOY=发布，ROLLBACK=回滚'
            )
        }

    tools {
        maven 'maven-3.8'
    }


    environment {
    APP_NAME = "lifpay-gateway"
    IMAGE_TAG = "v1.0"
    IMAGE_NAME = "${APP_NAME}:${IMAGE_TAG}"
    PORT = 9001
    NAMESPACE = "lifpay-test"
    //定义构建目录，方便清理
    BUILD_DIR = "${WORKSPACE}/parent/${APP_NAME}"
    }

    stages {
        stage('前置清理') {
            steps {
                echo "==================开始清理历史构建资源===================="
                 sh '''
                    #删除旧的Deployment
                    kubectl delete deployment ${APP_NAME} -n ${NAMESPACE} || true
                    # 清理集群内终止形态的旧Pod
                    kubectl delete pod -n ${NAMESPACE} --field-selector=status.phase=Failed || true
                    kubectl delete pod -n ${NAMESPACE} --field-selector=status.phase=Succeeded || true
                 '''
                 // 清理本地构建产物
                sh "rm -rf ${BUILD_DIR}/target || true"
                sh "rm -rf ${WORKSPACE}/parent/target || true"
                sh "rm -rf ${WORKSPACE}/@tmp || true"
                // 清理docker冗余资源
                sh '''
                    # 停止并删除所有关联容器
                    docker stop $(docker ps -a -q --filter name=${APP_NAME}) || true
                    docker rm $(docker ps -a -q --filter name=${APP_NAME}) || true
                    # 删除当前镜像
                    docker rmi -f ${IMAGE_NAME} || true
                    # 清理虚悬镜像
                    docker rmi -f $(docker images -f "dangling=true" -q) || true
                    # 清理该应用的历史版本镜像
                    docker rmi -f $(docker images -q ${APP_NAME}) || true
                '''
                echo "===================历史资源清理完成======================"
            }
        }


        stage('拉取代码') {
            steps {
                checkout scm
            }
        }


        stage('Maven打包') {
            steps {
               dir("parent") {
                   sh "mvn clean package -pl ${APP_NAME} -am -DskipTests"
               }


            }
        }

        stage('构建镜像') {
            steps {
                dir("parent/${APP_NAME}") {
                    sh "docker build -t ${IMAGE_NAME} ."
                    sh "docker images | grep ${IMAGE_NAME}"
                }
            }
        }

        // 推送镜像（暂时忽略）

        stage('部署到k3s集群') {
            when { expression { params.ACTION == 'DEPLOY'} }
            steps {
                dir("parent/${APP_NAME}") {
                    sh '''
                    kubectl apply --dry-run=client -f deploy.yaml -n ${NAMESPACE}
                    kubectl apply -f deploy.yaml -n ${NAMESPACE}
                    kubectl rollout status deployment/${APP_NAME} -n ${NAMESPACE} --timeout=120s
                    kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME}
                    kubectl get svc -n ${NAMESPACE} ${APP_NAME}-service
                    '''
                }
            }
        }

        stage('回滚到上一版本') {
            when { expression { params.ACTION == 'ROLLBACK'} }
            steps {
                sh 'kubectl rollout undo deployment/${APP_NAME} -n ${NAMESPACE}'
            }
        }

    }

    post {
        success {
            echo "===== 流水线执行成功！服务已部署成功 ====="
            sh '''
                echo "应用名称：${APP_NAME}"
                echo "镜像版本：${IMAGE_NAME}"
                echo "外访端口: c"
                echo "命令空间：${NAMESPACE}"
            '''
        }
        failure {
            echo "===== 流水线执行失败！====="
            // 失败时打印容器日志，方便排查
            sh "kubectl logs -n ${NAMESPACE} -l app=${APP_NAME} --tail=50 || true"
        }
        always {
            echo "===== 执行最终清理 ====="
            // 只删产物，不删BUILD_DIR（保留代码/Dockerfile）
            sh "rm -rf ${BUILD_DIR}/target || true"
            sh "rm -rf ${BUILD_DIR}/${APP_NAME}.tar || true"
            // 清理Docker退出容器（避免堆积）
            sh '''
            docker rm $(docker ps -a -q --filter status=exited) || true
            '''
        }

    }


}